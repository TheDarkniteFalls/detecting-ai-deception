{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thedarknitefalls.github.io/detecting-ai-deception/schemas/bazel-bep-artifact-created-request-v1.schema.json",
  "title": "DAID Bazel BEP artifact-created request v1",
  "description": "Strict request for the dependency-free Bazel BEP JSON 8.7.0 artifact-created adapter. Duplicate keys, non-NFC strings, explicit nulls, and nesting beyond 16 are rejected by the parser boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "source", "selection"],
  "properties": {
    "schema_version": {"const": "daid_bazel_bep_artifact_created_request_v1"},
    "claim_id": {"$ref": "#/$defs/nonEmptyString"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "sha256"],
      "properties": {
        "format": {"const": "bazel-build-event-protocol-json"},
        "version": {"const": "8.7.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_uuid", "target_label", "configuration_id", "output_group", "artifact"],
      "properties": {
        "build_uuid": {"$ref": "#/$defs/nonEmptyString"},
        "target_label": {"$ref": "#/$defs/nonEmptyString"},
        "configuration_id": {"$ref": "#/$defs/nonEmptyString"},
        "output_group": {"const": "default"},
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "path_prefix", "name", "digest", "length"],
          "properties": {
            "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
            "path_prefix": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1, "not": {"enum": [".", ".."]}, "pattern": "^[^/\\u0000]+$"}
            },
            "name": {"type": "string", "minLength": 1, "not": {"enum": [".", ".."]}, "pattern": "^[^/\\u0000]+$"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]+$"},
            "length": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1}
  }
}
