{
  "name": "detecting-ai-deception",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic claim-and-evidence cases for inspecting AI overstatement, omission and misrepresentation without inferring intent.",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:cases": "node tools/check-cases.mjs --self-test",
    "check:site": "node tools/check-site.mjs dist",
    "check:repository": "node tools/check-repository.mjs",
    "check:http": "node tools/check-http.mjs",
    "check": "node tools/check-all.mjs"
  },
  "engines": {"node": ">=20"},
  "license": "Apache-2.0"
}
